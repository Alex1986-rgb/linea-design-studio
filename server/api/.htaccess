# api/ — только PHP-обработчики, больше ничего не отдаём (вторая линия: данных здесь нет, они в ../../linea-private)
Options -Indexes
<IfModule mod_authz_core.c>
  <FilesMatch ".">
    Require all denied
  </FilesMatch>
  <FilesMatch "^(brief|brief-add|order|pay|pay-notify|ping|prices|review|admin|survey|admin-brigady|remont|remont-dogovor|katalog|vhod|kabinet|panel|brigada)\.php$">
    Require all granted
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <FilesMatch "^(brief|brief-add|order|pay|pay-notify|ping|prices|review|admin|survey|admin-brigady|remont|remont-dogovor|katalog|vhod|kabinet|panel|brigada)\.php$">
    Allow from all
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set Cache-Control "no-store"
  Header set Referrer-Policy "no-referrer"
</IfModule>
