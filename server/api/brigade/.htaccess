# api/brigade/ — только PHP-обработчики кабинета бригады; шаблон tpl/ и прочее закрыты (правило «всё закрыто» — в ../.htaccess)
Options -Indexes
<IfModule mod_authz_core.c>
  <FilesMatch "^(auth|profile|file|feed|offer|jobs|finance|sheets|sheet-request)\.php$">
    Require all granted
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(auth|profile|file|feed|offer|jobs|finance|sheets|sheet-request)\.php$">
    Allow from all
  </FilesMatch>
</IfModule>
# Воркер листов шлёт «Authorization: Bearer …» — на Beget (CGI) заголовок до PHP сам не доходит, пробрасываем в HTTP_AUTHORIZATION
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>
